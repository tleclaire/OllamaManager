{
  "name": "ollamamanager",
  "version": "0.1.0",
  "description": "Keyboard-driven TUI for monitoring and managing the local Ollama instance",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun build --compile src/index.tsx --outfile dist/ollama-manager",
    "install:bin": "bun run build && mkdir -p ~/.local/bin && cp dist/ollama-manager ~/.local/bin/",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
